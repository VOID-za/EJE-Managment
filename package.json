{
  "name": "eje-job-card-management",
  "version": "0.1.0-demo",
  "private": true,
  "description": "EJE Industrial Electronics - Job Card Management System (Demonstration System)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:test": "vitest run --config vitest.db.config.mts",
    "db:seed": "tsx src/db/seed/run.ts",
    "db:reset": "tsx src/db/seed/reset.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "workflow-check": "node scripts/job-workflow-check.mjs",
    "dev-check": "node scripts/dev-console-check.mjs",
    "check-routes": "node scripts/check-routes.mjs",
    "redeploy": "npm run clean && npm run build && npm run start",
    "clean": "node scripts/clean.mjs",
    "e2e": "node scripts/workflow-e2e.mjs",
    "pdf-check": "node scripts/pdf-visual-check.mjs",
    "pdf-pixels": "vitest run --config vitest.browser.config.mts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.5",
    "playwright": "^1.63.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
