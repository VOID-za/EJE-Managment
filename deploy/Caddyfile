# EJE Job Card Management — Caddy site file
#
# Install to /etc/caddy/Caddyfile on the VPS, TOGETHER WITH its neighbour:
#
#   sudo cp /srv/eje/app/deploy/Caddyfile           /etc/caddy/Caddyfile
#   sudo cp /srv/eje/app/deploy/cloudflare-ips.caddy /etc/caddy/cloudflare-ips.caddy
#
# `import` resolves relative to this file, so both must be in /etc/caddy.
#
# Caddy obtains and renews the certificate itself, so the application speaks
# plain HTTP on loopback and never holds a private key. Cloudflare in front of
# it is set to Full (strict), which is only honest because the certificate below
# is a real publicly-trusted one — see docs/vps-deployment.md.
{
	servers {
		# WHO IS ALLOWED TO SAY WHO THE CLIENT IS.
		#
		# Without this, `X-Forwarded-For` is a header anyone can send and the
		# login rate limiter in src/server/api/rate-limit.ts — which reads the
		# first entry — would be rate-limiting a string the attacker chose.
		# Generated; see deploy/cloudflare-ips.caddy.
		import cloudflare-ips.caddy
	}
}

eje.syncza.co.za {
	encode zstd gzip

	# The application listens on loopback only — see HOSTNAME in eje.service.
	reverse_proxy 127.0.0.1:3000 {
		# One value, and it is Caddy's own conclusion rather than a relayed
		# claim: with the trusted_proxies above, {client_ip} is CF-Connecting-IP
		# when the peer really is Cloudflare, and the TCP peer otherwise.
		# Replacing the header rather than appending to it is what makes the
		# application's `split(',')[0]` correct.
		header_up X-Forwarded-For {http.request.client_ip}
	}

	# Uploads: a job card photograph from a tablet is bigger than the default,
	# and a short video is bigger again.
	#
	# THIS NUMBER HAS TO COVER THE LARGEST THING THE APPLICATION ACCEPTS, which
	# is `MAX_VIDEO_BYTES` in `src/lib/upload-limits.ts` — 60 MB — plus room for
	# the multipart envelope and the other fields. At 30 MB this refused a video
	# the application would have taken, and refused it HERE: a 413 from the
	# proxy, with none of the application's own wording about what the limit is
	# or what to do instead, and nothing in the application's log to say it
	# happened. A technician would have seen a failure with no reason.
	#
	# If either limit changes, change both. The application is still the one
	# that measures and refuses properly; this is only the outer bound that
	# stops a deliberately enormous body being buffered at all.
	request_body {
		max_size 70MB
	}

	log {
		output file /var/log/caddy/eje.log
		format json
	}
}
